{
  "name": "corretors-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "expo": "58.0.19",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "bundle:android": "expo export --platform android --output-dir dist",
    "call-api": "node --experimental-strip-types scripts/call-api.ts"
  }
}
